       "estirar": false,
       "opciones": {},
       "elementos": [
        {
         "id": "e-9d4jxb",
         "tipo": "txtJustificado",
         "visible": true,
         "texto": "One table of 1 272 antiSMASH regions. 81 genomes appear twice (GenBank and RefSeq); merging the copies leaves 652 BGCs from 85 genomes. Seven classes with fewer than 10 BGCs are excluded."
        },
