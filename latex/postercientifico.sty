\ExplSyntaxOn
%% \PC@defcolor{nombre}{valor}: valor = 6 cifras hexadecimales (1F4E79) o un
%% color de xcolor (pcAcento!20, white, ...).
\cs_new_protected:Npn \PC@defcolor #1#2
  {
    \tl_set:Nx \l_tmpa_tl {#2}
    \tl_trim_spaces:N \l_tmpa_tl
    \exp_args:NnV \regex_match:nnTF { \A [0-9A-Fa-f]{6} \Z } \l_tmpa_tl
      { \use:x { \exp_not:N \definecolor {#1} {HTML} { \l_tmpa_tl } } }
      { \use:x { \exp_not:N \colorlet {#1} { \l_tmpa_tl } } }
  }
%% \PC@sinumero{valor}{si es un número sin unidades}{si no}
\cs_new_protected:Npn \PC@sinumero #1#2#3
  {
    \tl_set:Nx \l_tmpb_tl {#1}
    \exp_args:NnV \regex_match:nnTF { \A \s* [\+\-]? ( \d+ \.? \d* | \. \d+ ) \s* \Z } \l_tmpb_tl {#2} {#3}
  }
\ExplSyntaxOff
%% \PC@adim{valor}{referencia}{\macro}: 0.25 → 0.25×referencia ; 12cm → 12cm
\newcommand\PC@adim[3]{\PC@sinumero{#1}{\edef#3{\the\dimexpr#1#2\relax}}{\edef#3{\the\dimexpr#1\relax}}}
%% \PC@siclaves{arg}{si contiene «=»}{si no}
\newcommand\PC@siclaves[3]{\in@{=}{#1}\ifin@\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi{#2}{#3}}
\def\PC@novalor{\pgfkeysnovalue}
\newlength\PCsep \newlength\PCcolw
\newlength\PC@w \newlength\PC@h \newlength\PC@bw \newlength\PC@bh \newlength\PC@g
\newdimen\PC@tmpd \newdimen\PC@Hmax \newdimen\PC@T \newdimen\PC@disp
