       \setlength{\partopsep}{0pt}}#3\end{list}}%
    {\begin{list}{}{\settowidth{\labelwidth}{[99]}\setlength{\leftmargin}{\dimexpr\labelwidth+0.45em\relax}%
       \setlength{\labelsep}{0.45em}\setlength{\itemsep}{0.3em}\setlength{\parsep}{0pt}\setlength{\topsep}{0pt}%
       \setlength{\partopsep}{0pt}\renewcommand{\makelabel}[1]{\hfil##1}}#3\end{list}}%
  \ifnum#2>1 \end{multicols}\fi\par}\PC@despues}
\newcommand{\PCbibliografiavacia}{\PC@antesV{\tam{\PC@escref}\color{pcTenue}\itshape
  Aún no hay referencias citadas. Agrégalas en el panel Referencias y cítalas en el texto con [@clave].\par}\PC@despues}
