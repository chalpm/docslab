  alto logos/.store in=\PC@logoh,               alto logos=5.5em,
  escala logo izquierdo/.store in=\PC@logoescL, escala logo izquierdo=1, % tamaño de cada logo
  escala logo derecho/.store in=\PC@logoescR,   escala logo derecho=1,
  pie/.store in=\PC@estpie,                     pie=banda,        % banda | clara | ninguno
  % ---- Cajas ----
