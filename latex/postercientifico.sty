  radio/.store in=\PC@radio,                    radio=0.3em,
  relleno/.store in=\PC@relleno,                relleno=0.75em,
  mostrar titulos/.is if=PC@mostrartit,         mostrar titulos=true,
  numerar bloques/.is if=PC@numbloques,         numerar bloques=false,
  alineacion titulos/.store in=\PC@alintit,     alineacion titulos=izquierda,
  alinear texto/.store in=\PC@alintxt,          alinear texto=justificado, % izquierda | centro | derecha | justificado
