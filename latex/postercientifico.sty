%% ---- Familias tipográficas (todas escalables) -------------------------------
%%  «familia» (el texto) y «familia titulos» admiten:
%%   · las clásicas de PostScript: helvetica, avantgarde, palatino, times, bookman, charter;
%%   · las libres de TeX Live (con pdfLaTeX): sourcesans, fira, roboto, lato, opensans,
%%     notosans, plexsans, atkinson, montserrat, raleway, cabin, inter, libertinus,
%%     ebgaramond, merriweather, sourceserif, crimson, notoserif, plexserif;
%%   · las propias, con LuaLaTeX, declaradas en el preámbulo con
%%       \posterfamilia{nombre}{carpeta/}{normal.ttf}{negrita.ttf}{cursiva.ttf}{negrita-cursiva.ttf}
%%     (negrita y cursivas pueden quedar vacías: se imitan a partir de la normal).
%%  Con LuaLaTeX, las clásicas se cambian por sus gemelas OpenType (TeX Gyre y XCharter).
%% \PC@famtex{nombre}{código NFSS}{paquete}{opciones}: la familia con pdfLaTeX
\newcommand\PC@famtex[4]{\@namedef{PC@cod@#1}{#2}%
  \@namedef{PC@paq@#1}{\ifstrempty{#3}{}{\@ifpackageloaded{#3}{}{\RequirePackage[#4]{#3}}}}}
%% \PC@famotf{nombre}{carpeta}{normal}{negrita}{cursiva}{negrita cursiva}{escala}: con LuaLaTeX
\newcommand\PC@famotf[7]{\@namedef{PC@otf@#1}{{#2}{#3}{#4}{#5}{#6}{#7}}}
\newcommand\posterfamilia[6]{\PC@famotf{#1}{#2}{#3}{#4}{#5}{#6}{1}}
