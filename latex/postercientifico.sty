  \begin{minipage}[t]{\dimexpr\linewidth-#1\linewidth-1em\relax}\vspace{0pt}\PC@parrafos#4\end{minipage}\PC@despues}
%% I07 · imagen a la derecha, texto a la izquierda    \imgTextoIzquierda[fracción]{archivo}{pie}{texto}
\newcommand{\imgTextoIzquierda}[4][0.45]{\PC@antesT
