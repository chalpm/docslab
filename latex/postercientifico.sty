%% ============================================================================
%%  postercientifico.sty · v3.0 · Pósters POR CAPAS, presentaciones y documentos
%%  ---------------------------------------------------------------------------
%%  El póster se pinta en capas, de atrás hacia delante:
%%
%%      capa «fondo»      z = -10   imágenes, formas y textos detrás de todo
%%      CONTENIDO         z =   0   cabecera, filas de columnas con cajas, pie
%%      capa «frente»     z =  10   sellos, logotipos y notas encima de todo
%%      ... y las capas que crees con \nuevacapa[z=<número>]{nombre}
%%
%%  Cada capa se puede ocultar, mover de orden o atenuar:
%%      \configcapa{fondo}{visible=false}     \configcapa{frente}{z=20, opacidad=0.5}
%%  y recibe elementos con posición absoluta. x e y van de 0 a 1 desde la
%%  esquina superior izquierda (o con unidades: 12cm, 40mm):
%%      \colocarimagen[capa=fondo, x=0, y=0, ancla=north west, ancho=1, alto=1,
%%                     ajuste=cubrir, opacidad=0.1]{img/fondo.jpg}
%%      \colocartexto[capa=frente, x=0.5, y=0.5, rotacion=30, escala=8,
%%                    opacidad=0.15, color=pcAcento, negrita]{BORRADOR}
%%      \colocarforma[capa=fondo, forma=circulo, x=0.9, y=0.1, ancho=0.3,
%%                    fondo=pcSecundario!20]
%%
%%  El contenido se organiza en filas de columnas con cajas:
%%      \begin{fila}[columnas=3, alto=llenar]
%%        \begin{columna}[abarca=1]
%%          \begin{caja}[titulo={Introducción}] ... \end{caja}
%%          \begin{caja}[titulo={Métodos}, mostrar titulo=false] ... \end{caja}
%%        \end{columna}
%%        ...
%%      \end{fila}
%%  Las columnas de una fila terminan a la misma altura y las cajas se reparten
%%  el espacio. «alto=llenar» hace que la fila ocupe todo el alto libre hasta
%%  el pie (necesita dos compilaciones).
%%
%%  Cada caja admite: titulo, mostrar titulo=true|false (o «sin titulo»),
%%  estilo, numero, fondo, borde, grosor borde, radio, relleno, color titulo,
%%  fondo titulo, color texto, escala titulo, escala texto, alineacion titulo,
%%  alinear texto, columnas, alto, opacidad, sombra, estirar, visible, id y
%%  cualquier opción de tcolorbox.
%%
%%  Todo lo de la versión 1 sigue funcionando: \posterconfig, bloque,
%%  bloquesimple, columnas/columna, \cabecera, \piedeposter y las 68 variantes
%%  (\img... y \txt...), a las que se suma T35 \txtCaja.
%%
%%  Compila con pdfLaTeX (o con LuaLaTeX si usas tipografías propias, ver
%%  «Familias tipográficas»). Dos pasadas si usas alto=llenar o estirar
%%  (latexmk y Overleaf repiten solos).
%% ============================================================================
\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{postercientifico}[2026/11/16 v3.0 Posters por capas, presentaciones y documentos]

