  progreso/.is if=PC@dpprog,                    progreso=false,   % barra de avance abajo
  % ---- Capas y aplicación ----
  contenido visible/.is if=PC@contenido,
  marcas/.is if=PC@marcas,                      marcas=false,     % posiciones para la aplicación web
  depurar/.is if=PC@depurar,                    depurar=false,    % escribe en el .log el cálculo de las filas
  % ---- Imprenta ----
  sangrado/.store in=\PC@sangrado,              sangrado=0pt,     % el fondo pasa del borde (la imprenta suele pedir 3mm)
  marcas corte/.is if=PC@marcascorte,           marcas corte=false, % marcas de corte alrededor del póster
  % ---- Colores (hexadecimal sin #, o un color de xcolor) ----
