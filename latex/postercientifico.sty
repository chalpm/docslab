%%       Las citas del texto llegan ya escritas: \PCcita{(García, 2020)} o \PCcitasup{1,3}.
\newcommand{\PCcita}[1]{#1}
\newcommand{\PCcitasup}[1]{\textsuperscript{#1}}
\newcommand{\PCcitadesconocida}[1]{\textbf{\color{red!70!black}[?#1]}%
  \PackageWarning{postercientifico}{Cita desconocida: #1 (no está en las referencias)}}
\newcommand{\PCurl}[1]{#1}
\newcommand{\PCref}[2]{\item[{#1}]#2}
\NewDocumentCommand{\PCbibliografia}{O{numerica} O{1} +m}{\PC@antesV{\tam{\PC@escref}\raggedright
  \ifnum#2>1 \setlength{\columnsep}{1.2em}\setlength{\multicolsep}{0pt}\begin{multicols}{#2}\fi
